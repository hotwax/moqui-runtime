    </eeca>
    <eeca id="CcrUngated_SystemMessageRemote" entity="moqui.service.message.SystemMessageRemote" on-update="true" run-on-error="false" get-original-value="true" get-entire-entity="true">
        <actions><set field="eecaEntityName" value="moqui.service.message.SystemMessageRemote"/><script location="component://config-approval/script/UngatedWrite.groovy"/></actions>
    </eeca>
</eecas>
