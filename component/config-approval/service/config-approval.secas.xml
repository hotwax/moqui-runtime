<?xml version="1.0" encoding="UTF-8"?>
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- POC: gate on update#ServiceJob only. hold() strips guarded fields from the live params in pre-validate;
         record() saves the request in post-service (only runs when the service succeeded). -->
    <seca id="CcrHold_ServiceJobUpdate" service="update#moqui.service.job.ServiceJob" when="pre-validate">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="update#moqui.service.job.ServiceJob"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_ServiceJobUpdate" service="update#moqui.service.job.ServiceJob" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>

    <!-- The maarg-util wrapper (REST PUT /serviceJobs/{jobName}) declares only its own parameters, so it must be gated
         itself to see _changeReason; it strips paused, so the inner entity-auto call finds nothing left to hold. -->
    <seca id="CcrHold_JobServicesUpdate" service="co.hotwax.job.JobServices.update#ServiceJob" when="pre-validate">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="co.hotwax.job.JobServices.update#ServiceJob"/>
            <set field="gateEntityName" value="moqui.service.job.ServiceJob"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_JobServicesUpdate" service="co.hotwax.job.JobServices.update#ServiceJob" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>

    <!-- More guarded entities. REST PUT on SystemMessageRemote runs store#, and JobServices.update#ServiceJob stores job
         parameters through store#ServiceJobParameter, so both verbs are gated. Only changes to existing records are held. -->
    <seca id="CcrHold_SjParamUpdate" service="update#moqui.service.job.ServiceJobParameter" when="pre-validate">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="update#moqui.service.job.ServiceJobParameter"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_SjParamUpdate" service="update#moqui.service.job.ServiceJobParameter" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrHold_SjParamStore" service="store#moqui.service.job.ServiceJobParameter" when="pre-validate">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="store#moqui.service.job.ServiceJobParameter"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_SjParamStore" service="store#moqui.service.job.ServiceJobParameter" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrHold_SmrUpdate" service="update#moqui.service.message.SystemMessageRemote" when="pre-validate">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="update#moqui.service.message.SystemMessageRemote"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_SmrUpdate" service="update#moqui.service.message.SystemMessageRemote" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrHold_SmrStore" service="store#moqui.service.message.SystemMessageRemote" when="pre-validate">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="store#moqui.service.message.SystemMessageRemote"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_SmrStore" service="store#moqui.service.message.SystemMessageRemote" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>

    <!-- Adding or deleting a record cannot be done by stripping fields: the request is saved in its own transaction and the
         service is stopped with a "request sent" message (see ApprovalGate.groovy) -->
    <seca id="CcrHold_SjParamCreate" service="create#moqui.service.job.ServiceJobParameter" when="pre-service">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="create#moqui.service.job.ServiceJobParameter"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrHold_SjParamDelete" service="delete#moqui.service.job.ServiceJobParameter" when="pre-service">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="delete#moqui.service.job.ServiceJobParameter"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrHold_SmrCreate" service="create#moqui.service.message.SystemMessageRemote" when="pre-service">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="create#moqui.service.message.SystemMessageRemote"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrHold_SmrDelete" service="delete#moqui.service.message.SystemMessageRemote" when="pre-service">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="delete#moqui.service.message.SystemMessageRemote"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrHold_SjDelete" service="delete#moqui.service.job.ServiceJob" when="pre-service">
        <actions>
            <set field="gatePhase" value="hold"/>
            <set field="gateServiceName" value="delete#moqui.service.job.ServiceJob"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>

    <!-- break-glass add/delete runs the real service, so the record phase writes its audit row (a held one never gets here) -->
    <seca id="CcrRecord_SjParamCreate" service="create#moqui.service.job.ServiceJobParameter" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_SjParamDelete" service="delete#moqui.service.job.ServiceJobParameter" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_SmrCreate" service="create#moqui.service.message.SystemMessageRemote" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_SmrDelete" service="delete#moqui.service.message.SystemMessageRemote" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>
    <seca id="CcrRecord_SjDelete" service="delete#moqui.service.job.ServiceJob" when="post-service">
        <actions>
            <set field="gatePhase" value="record"/>
            <script location="component://config-approval/script/ApprovalGate.groovy"/>
        </actions>
    </seca>

    <!-- The request is created inside the caller's transaction (nested call), where post-commit fires BEFORE the real
         commit. tx-commit registers on the transaction itself and runs after it commits, in its own thread and
         transaction, so the email sees the committed row and a mail failure can never roll back the maker's edit. -->
    <seca id="CcrEmail_Created" service="co.hotwax.configapproval.ConfigApprovalServices.create#ConfigChangeRequest" when="tx-commit">
        <actions><service-call name="co.hotwax.configapproval.ConfigApprovalServices.send#ConfigChangeEmail"
                in-map="[requestId:requestId, emailTemplateId:'CCR_APPROVAL_REQUEST']"/></actions>
    </seca>
    <!-- approve# commits the Approved status first, then the replay runs in its own transaction -->
    <seca id="CcrApply_Approved" service="co.hotwax.configapproval.ConfigApprovalServices.approve#ConfigChangeRequest" when="post-commit">
        <actions><service-call name="co.hotwax.configapproval.ConfigApprovalServices.apply#ConfigChangeRequest"
                in-map="[requestId:requestId]"/></actions>
    </seca>
    <seca id="CcrApply_BreakGlass" service="co.hotwax.configapproval.ConfigApprovalServices.breakGlass#ConfigChangeRequest" when="post-commit">
        <actions><service-call name="co.hotwax.configapproval.ConfigApprovalServices.apply#ConfigChangeRequest"
                in-map="[requestId:requestId]"/></actions>
    </seca>
    <seca id="CcrApply_Retry" service="co.hotwax.configapproval.ConfigApprovalServices.retry#ConfigChangeRequest" when="post-commit">
        <actions><service-call name="co.hotwax.configapproval.ConfigApprovalServices.apply#ConfigChangeRequest"
                in-map="[requestId:requestId]"/></actions>
    </seca>
    <!-- break-glass rows are written inside the caller's transaction too, so mail after the real commit like CcrEmail_Created -->
    <seca id="CcrEmail_BreakGlass" service="co.hotwax.configapproval.ConfigApprovalServices.record#BreakGlassChange" when="tx-commit">
        <actions><service-call name="co.hotwax.configapproval.ConfigApprovalServices.send#ConfigChangeEmail"
                in-map="[requestId:requestId, emailTemplateId:'CCR_BREAK_GLASS']"/></actions>
    </seca>
    <seca id="CcrEmail_Applied" service="co.hotwax.configapproval.ConfigApprovalServices.apply#ConfigChangeRequest" when="post-commit">
        <actions><service-call name="co.hotwax.configapproval.ConfigApprovalServices.send#ConfigChangeEmail"
                in-map="[requestId:requestId, emailTemplateId:'CCR_DECISION']"/></actions>
    </seca>
    <seca id="CcrEmail_Rejected" service="co.hotwax.configapproval.ConfigApprovalServices.reject#ConfigChangeRequest" when="post-commit">
        <actions><service-call name="co.hotwax.configapproval.ConfigApprovalServices.send#ConfigChangeEmail"
                in-map="[requestId:requestId, emailTemplateId:'CCR_DECISION']"/></actions>
    </seca>

    <!-- a held create/delete stops with an error; this turns it into a plain "request sent" message (see HeldMessage.groovy) -->
    <seca id="CcrHeldMsg_SjParamCreate" service="create#moqui.service.job.ServiceJobParameter" when="post-commit" run-on-error="true">
        <actions><script location="component://config-approval/script/HeldMessage.groovy"/></actions>
    </seca>
    <seca id="CcrHeldMsg_SjParamDelete" service="delete#moqui.service.job.ServiceJobParameter" when="post-commit" run-on-error="true">
        <actions><script location="component://config-approval/script/HeldMessage.groovy"/></actions>
    </seca>
    <seca id="CcrHeldMsg_SmrCreate" service="create#moqui.service.message.SystemMessageRemote" when="post-commit" run-on-error="true">
        <actions><script location="component://config-approval/script/HeldMessage.groovy"/></actions>
    </seca>
    <seca id="CcrHeldMsg_SmrDelete" service="delete#moqui.service.message.SystemMessageRemote" when="post-commit" run-on-error="true">
        <actions><script location="component://config-approval/script/HeldMessage.groovy"/></actions>
    </seca>
    <seca id="CcrHeldMsg_SjDelete" service="delete#moqui.service.job.ServiceJob" when="post-commit" run-on-error="true">
        <actions><script location="component://config-approval/script/HeldMessage.groovy"/></actions>
    </seca>
</secas>
