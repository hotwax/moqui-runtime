<?xml version="1.0" encoding="UTF-8"?>
<!-- POC seed: status flow, change source/type, guarded fields, groups, email templates -->
<entity-facade-xml type="seed">
    <moqui.basic.StatusType statusTypeId="ConfigChangeRequest" description="Config Change Request"/>
    <moqui.basic.StatusItem statusTypeId="ConfigChangeRequest" statusId="CcrPending"   sequenceNum="1" description="Pending approval"/>
    <moqui.basic.StatusItem statusTypeId="ConfigChangeRequest" statusId="CcrApproved"  sequenceNum="2" description="Approved"/>
    <moqui.basic.StatusItem statusTypeId="ConfigChangeRequest" statusId="CcrApplied"   sequenceNum="3" description="Applied"/>
    <moqui.basic.StatusItem statusTypeId="ConfigChangeRequest" statusId="CcrFailed"    sequenceNum="4" description="Failed"/>
    <moqui.basic.StatusItem statusTypeId="ConfigChangeRequest" statusId="CcrRejected"  sequenceNum="5" description="Rejected"/>
    <moqui.basic.StatusItem statusTypeId="ConfigChangeRequest" statusId="CcrCancelled" sequenceNum="6" description="Cancelled"/>
    <moqui.basic.StatusItem statusTypeId="ConfigChangeRequest" statusId="CcrExpired"   sequenceNum="7" description="Expired"/>

    <moqui.basic.StatusFlow statusFlowId="ConfigChangeRequest" statusTypeId="ConfigChangeRequest" description="Config change approval"/>
    <moqui.basic.StatusFlowTransition statusFlowId="ConfigChangeRequest" statusId="CcrPending"  toStatusId="CcrApproved"  transitionName="Approve"/>
    <moqui.basic.StatusFlowTransition statusFlowId="ConfigChangeRequest" statusId="CcrPending"  toStatusId="CcrRejected"  transitionName="Reject"/>
    <moqui.basic.StatusFlowTransition statusFlowId="ConfigChangeRequest" statusId="CcrPending"  toStatusId="CcrCancelled" transitionName="Cancel"/>
    <moqui.basic.StatusFlowTransition statusFlowId="ConfigChangeRequest" statusId="CcrPending"  toStatusId="CcrExpired"   transitionName="Expire"/>
    <moqui.basic.StatusFlowTransition statusFlowId="ConfigChangeRequest" statusId="CcrApproved" toStatusId="CcrApplied"   transitionName="Apply"/>
    <moqui.basic.StatusFlowTransition statusFlowId="ConfigChangeRequest" statusId="CcrApproved" toStatusId="CcrFailed"    transitionName="Fail"/>
    <moqui.basic.StatusFlowTransition statusFlowId="ConfigChangeRequest" statusId="CcrFailed"   toStatusId="CcrApproved"  transitionName="Retry"/>
    <moqui.basic.StatusFlowTransition statusFlowId="ConfigChangeRequest" statusId="CcrFailed"   toStatusId="CcrCancelled" transitionName="Cancel"/>

    <moqui.basic.EnumerationType enumTypeId="ConfigChangeSource" description="Config change source"/>
    <moqui.basic.Enumeration enumTypeId="ConfigChangeSource" enumId="CcsApproval"   description="Approval request"/>
    <moqui.basic.Enumeration enumTypeId="ConfigChangeSource" enumId="CcsBreakGlass" description="Break-glass"/>
    <moqui.basic.Enumeration enumTypeId="ConfigChangeSource" enumId="CcsUngated"    description="Changed without approval"/>
    <moqui.basic.EnumerationType enumTypeId="ConfigChangeType" description="Config change type"/>
    <moqui.basic.Enumeration enumTypeId="ConfigChangeType" enumId="CctUpdate" description="Update"/>
    <moqui.basic.Enumeration enumTypeId="ConfigChangeType" enumId="CctCreate" description="Create"/>
    <moqui.basic.Enumeration enumTypeId="ConfigChangeType" enumId="CctDelete" description="Delete"/>

    <!-- Guarded fields. enumCode = Entity.field. optionIndicator Y = secret. optionValue N = area switched off -->
    <moqui.basic.EnumerationType enumTypeId="ConfigApprovalField" description="Fields that need approval to change"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSjPaused" enumCode="moqui.service.job.ServiceJob.paused" description="Job on/off"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSjCron" enumCode="moqui.service.job.ServiceJob.cronExpression" description="Job schedule (cron)"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSjFrom" enumCode="moqui.service.job.ServiceJob.fromDate" description="Job runs from"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSjThru" enumCode="moqui.service.job.ServiceJob.thruDate" description="Job runs until"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSjRepeat" enumCode="moqui.service.job.ServiceJob.repeatCount" description="Job repeat count"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSjpValue" enumCode="moqui.service.job.ServiceJobParameter.parameterValue" description="Job parameter value"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSmrUrl" enumCode="moqui.service.message.SystemMessageRemote.sendUrl" description="Remote send URL"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSmrRUrl" enumCode="moqui.service.message.SystemMessageRemote.receiveUrl" description="Remote receive URL"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSmrUser" enumCode="moqui.service.message.SystemMessageRemote.username" description="Remote username"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSmrPw" enumCode="moqui.service.message.SystemMessageRemote.password" optionIndicator="Y" description="Remote password"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSmrPrivKey" enumCode="moqui.service.message.SystemMessageRemote.privateKey" optionIndicator="Y" description="Remote private key"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSmrPubKey" enumCode="moqui.service.message.SystemMessageRemote.publicKey" description="Remote public key"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSmrRPubKey" enumCode="moqui.service.message.SystemMessageRemote.remotePublicKey" description="Remote's public key"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSmrSecret" enumCode="moqui.service.message.SystemMessageRemote.sharedSecret" optionIndicator="Y" description="Remote shared secret"/>
    <moqui.basic.Enumeration enumTypeId="ConfigApprovalField" enumId="CafSmrSSecret" enumCode="moqui.service.message.SystemMessageRemote.sendSharedSecret" optionIndicator="Y" description="Remote send shared secret"/>

    <moqui.security.UserGroup userGroupId="CONFIG_APPROVERS" description="Config change approvers"/>
    <moqui.security.UserGroup userGroupId="CONFIG_BREAK_GLASS" description="Config change break-glass (on-call leads)"/>
    <moqui.security.UserGroup userGroupId="CONFIG_APPROVAL_BYPASS" description="Config approval bypass (system accounts only)"/>

    <!-- approvers may open the Change Approval screens, read requests and decide them -->
    <moqui.security.ArtifactGroup artifactGroupId="CONFIG_APPROVAL_UI" description="Change Approval screens and decision services"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="CONFIG_APPROVAL_UI" artifactTypeEnumId="AT_XML_SCREEN" nameIsPattern="Y" inheritAuthz="Y"
            artifactName="component://config-approval/screen/ChangeApproval.*"/>
    <!-- the decide buttons are screen transitions (POST), which are a separate artifact type from the screens -->
    <moqui.security.ArtifactGroupMember artifactGroupId="CONFIG_APPROVAL_UI" artifactTypeEnumId="AT_XML_SCREEN_TRANS" nameIsPattern="Y" inheritAuthz="Y"
            artifactName="component://config-approval/screen/ChangeApproval.*"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="CONFIG_APPROVAL_UI" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"
            artifactName="co.hotwax.configapproval.ConfigChangeRequest"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="CONFIG_APPROVAL_UI" artifactTypeEnumId="AT_SERVICE" nameIsPattern="Y" inheritAuthz="Y"
            artifactName="co.hotwax.configapproval.ConfigApprovalServices.*"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="CONFIG_APPROVAL_UI_APR" userGroupId="CONFIG_APPROVERS" artifactGroupId="CONFIG_APPROVAL_UI"
            authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>

    <!-- everyone else may open the screens and see (and cancel) their own requests; the screens filter to the requester's own -->
    <moqui.security.ArtifactGroup artifactGroupId="CONFIG_APPROVAL_OWN_VIEW" description="Change Approval screens and request list (own requests)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="CONFIG_APPROVAL_OWN_VIEW" artifactTypeEnumId="AT_XML_SCREEN" nameIsPattern="Y" inheritAuthz="Y"
            artifactName="component://config-approval/screen/ChangeApproval.*"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="CONFIG_APPROVAL_OWN_VIEW" artifactTypeEnumId="AT_XML_SCREEN_TRANS" nameIsPattern="Y" inheritAuthz="Y"
            artifactName="component://config-approval/screen/ChangeApproval.*"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="CONFIG_APPROVAL_OWN_VIEW" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"
            artifactName="co.hotwax.configapproval.ConfigChangeRequest"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="CONFIG_APPROVAL_OWN_VIEW" userGroupId="ALL_USERS" artifactGroupId="CONFIG_APPROVAL_OWN_VIEW"
            authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_VIEW"/>
    <moqui.security.ArtifactGroup artifactGroupId="CONFIG_APPROVAL_OWN_ACT" description="Cancel own request and read the digest"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="CONFIG_APPROVAL_OWN_ACT" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y"
            artifactName="co.hotwax.configapproval.ConfigApprovalServices.cancel#ConfigChangeRequest"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="CONFIG_APPROVAL_OWN_ACT" artifactTypeEnumId="AT_XML_SCREEN_TRANS"
            artifactName="component://config-approval/screen/ChangeApproval/Request.xml/cancel"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="CONFIG_APPROVAL_OWN_ACT" userGroupId="ALL_USERS" artifactGroupId="CONFIG_APPROVAL_OWN_ACT"
            authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>

    <moqui.basic.email.EmailTemplate emailTemplateId="CCR_APPROVAL_REQUEST" description="Config change: approval needed"
            emailServerId="SYSTEM" webappName="webroot" sendPartial="Y" fromName="HotWax Commerce" fromAddress="noreply@hotwax.co"
            bodyScreenLocation="component://config-approval/screen/email/ApprovalRequest.xml"
            subject="Approval needed: ${summaryText} (CR ${requestId})"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="CCR_APPROVAL_REMINDER" description="Config change: still waiting for approval"
            emailServerId="SYSTEM" webappName="webroot" sendPartial="Y" fromName="HotWax Commerce" fromAddress="noreply@hotwax.co"
            bodyScreenLocation="component://config-approval/screen/email/ApprovalRequest.xml"
            subject="Reminder, still waiting: ${summaryText} (CR ${requestId})"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="CCR_BREAK_GLASS" description="Config change: break-glass used"
            emailServerId="SYSTEM" webappName="webroot" sendPartial="Y" fromName="HotWax Commerce" fromAddress="noreply@hotwax.co"
            bodyScreenLocation="component://config-approval/screen/email/Decision.xml"
            subject="Break-glass used: ${summaryText} (CR ${requestId})"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="CCR_DECISION" description="Config change: decided or applied"
            emailServerId="SYSTEM" webappName="webroot" sendPartial="Y" fromName="HotWax Commerce" fromAddress="noreply@hotwax.co"
            bodyScreenLocation="component://config-approval/screen/email/Decision.xml"
            subject="${statusDescription}: ${summaryText} (CR ${requestId})"/>

    <!-- expires and reminds every 15 minutes -->
    <moqui.service.job.ServiceJob jobName="ConfigApproval_Sweep" description="Expire and remind pending config change requests"
            serviceName="co.hotwax.configapproval.ConfigApprovalServices.run#ConfigApprovalSweep" cronExpression="0 0/15 * * * ?" paused="N"/>
</entity-facade-xml>
