<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="false" standalone="true">
    <widgets>
        <render-mode><text type="html"><![CDATA[
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Change request update</title>
    <style>
        body { margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4; color: #333; }
        .emailBody { width: 100%; background-color: #f4f4f4; padding: 20px 0; }
        .emailBasicTable { width: 600px; margin: 0 auto; background-color: #ffffff; border-collapse: collapse; }
        .emailContentTable { width: 100%; border-collapse: collapse; }
        .emailLogo td { padding: 20px; background-color: #ffffff; }
        .emailTitle td { padding: 10px 20px; background-color: #f8f8f8; }
        .date { margin: 0; font-size: 12px; color: #999; }
        .box { padding: 20px; font-size: 14px; line-height: 1.6; }
        .diffTable { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 13px; }
        .diffTable th { text-align: left; background-color: #f8f8f8; padding: 6px 10px; border: 1px solid #e5e5e5; }
        .diffTable td { padding: 6px 10px; border: 1px solid #e5e5e5; }
        .oldValue { color: #999; text-decoration: line-through; }
        .emailButton { display: inline-block; padding: 10px 20px; background-color: #e31c3d; color: #ffffff; text-decoration: none; border-radius: 4px; font-size: 14px; }
        .emailFooter { width: 600px; margin: 0 auto; padding: 10px 0; text-align: center; font-size: 12px; color: #999; }
    </style>
</head>
<body>
<div class="emailBody">
    <table class="emailBasicTable"><tbody><tr><td>
        <table class="emailContentTable emailLogo"><tbody><tr>
            <td><a href="https://www.hotwax.co/" target="_blank"><img alt="HotWax Commerce" src="https://d3k81ch9hvuctc.cloudfront.net/company/TVNEiQ/images/748ea00a-d14c-4a0e-ad46-09df5199c06a.png" style="display:block;outline:none;text-decoration:none;height:auto;width:200px;" width="200"/></a></td>
        </tr></tbody></table>
        <table class="emailContentTable">
            <thead><tr><td class="emailTitle"><p class="date">${.now?string["MMMM dd, yyyy"]}</p></td></tr></thead>
            <tbody><tr><td class="box">
<p>Hello ${requesterName},</p>
<p>Your change request <b>${summaryText}</b> (CR ${requestId}) is now <b>${statusDescription}</b><#if deciderName??> (decided by ${deciderName})</#if>.</p>
<#if decisionComment??><p>Comment: ${decisionComment}</p></#if>
<#if errorText??><p>It could not be applied: ${errorText}</p></#if>
<table class="diffTable">
    <tr><th>Setting</th><th>Current</th><th>Requested</th></tr>
    <#list diffList as d><tr><td>${d.field}</td><td class="oldValue">${d.oldValue!"(empty)"}</td><td><b>${d.newValue!"(empty)"}</b></td></tr></#list>
</table>
<p><a class="emailButton" href="${reviewUrl}" style="display:inline-block;padding:10px 20px;background-color:#e31c3d;color:#ffffff;text-decoration:none;border-radius:4px;">View request</a></p>
            </td></tr></tbody>
        </table>
    </td></tr></tbody></table>
    <div class="emailFooter"><table class="emailBasicTable"><tr><td>&copy; ${.now?string["yyyy"]} HotWax Commerce. All rights reserved.</td></tr></table></div>
</div>
</body>
</html>
        ]]></text></render-mode>
    </widgets>
</screen>
