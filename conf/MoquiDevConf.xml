<!--    <default-property name="entity_ds_c1_db_conf" value="mysql8"/>-->
<!--    <default-property name="entity_ds_c1_user" value="root"/>-->
<!--    <default-property name="entity_ds_c1_password" value="Puru@1234" is-secret="true"/>-->
<!--    <default-property name="entity_ds_c1_database" value="qa"/>-->
<!--    <default-property name="entity_ds_c1_disabled" value="false"/>-->

    <default-property name="bi_entity_ds_db_conf" value="mysql8"/>
    <default-property name="bi_entity_ds_host" value="127.0.0.1"/>
    <default-property name="bi_entity_ds_database" value="moqui_bi"/>
    <default-property name="bi_entity_ds_user" value="root"/>
    <default-property name="bi_entity_ds_password" value="Puru@1234"/>

    <default-property name="default_time_zone" value="America/Los_Angeles"/>
    <default-property name="database_time_zone" value="America/Los_Angeles"/>
    <default-property name="default_locale" value="en_US"/>

